# Copy this file to .env and fill values before starting the backend

# Admin authentication
ADMIN_EMAIL=admin@diversia.local
ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=YourSuperSecretJWTKey

# SMTP provider settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_API_KEY
FROM_EMAIL=no-reply@yourdomain.com

# Email admin recipient
ADMIN_EMAIL=admin@yourdomain.com

# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=diversia

# Optional: DATABASE_URL can be used instead of individual DB vars
DATABASE_URL=your_database_url_here
